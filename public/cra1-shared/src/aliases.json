{
  "website": {
    "cui-dark": ":is(.footer-night,.night-section)",
    "cui-card": ":is(.glass-card,.hairline-card,.feature-item,.product-card,.bento-card,.bento-featured,.article-card,.pricing-card,.price-card,.solution-card,.proof-card,.doc-card,.link-tile,.choice-card,.quote-card,.compare-card,.cascade-item):not(:where(.cra1-marketing--product #overview *, .cra1-marketing--product #advantages *))",
    "cui-card--featured": ":is(.bento-featured,.product-card-featured)",
    "cui-button": ".btn:not(.btn-aurora)",
    "cui-button--primary": ".btn-primary:not(.btn-aurora)",
    "cui-button--outline": ".btn-outline:not(.btn-aurora)",
    "cui-button--ghost": ".btn-ghost:not(.btn-aurora)",
    "cui-button--danger": ".btn-error:not(.btn-aurora)",
    "cui-button--sm": ":is(.btn-sm,.btn-xs):not(.btn-aurora)",
    "cui-input": ":is(.input,.textarea,.select)",
    "cui-input--success": ".input-success",
    "cui-textarea": ".textarea",
    "cui-checkbox": ".checkbox",
    "cui-radio": ".radio",
    "cui-switch": ".toggle",
    "cui-range": ".range",
    "cui-button--link": ".btn-link:not(.btn-aurora)",
    "cui-arrow": "[data-cui-arrow]",
    "cui-badge": ".badge",
    "cui-badge--accent": ".badge-primary",
    "cui-badge--success": ".badge-success",
    "cui-badge--warning": ".badge-warning",
    "cui-badge--danger": ".badge-error",
    "cui-badge--silver": ".badge-neutral",
    "cui-badge--graphite": ".badge-ghost"
  },
  "system": {
    "cui-button": ":is(.el-button,.cl-rail-buy,.cl-btn,.f-order .buy)",
    "cui-button--primary": ":is(.el-button--primary,.cl-rail-buy,.cl-btn--primary,.f-order .buy)",
    "cui-button--outline": ":is(.el-button:not(.el-button--primary):not(.el-button--danger):not(.el-button--text),.cl-btn--ghost)",
    "cui-button--ghost": ".el-button--text",
    "cui-button--danger": ".el-button--danger",
    "cui-button--sm": ".el-button--small",
    "cui-input": ":is(.el-input__inner,.el-textarea__inner)",
    "cui-textarea": ".el-textarea__inner",
    "cui-input--success": ".is-success .el-input__inner",
    "cui-card": ":is(.main-card,.el-card,.cl-goods-card,.cl-rail-card,.cl-product-info,.cl-config-panel,.shopping-item)",
    "cui-table": ".el-table__body",
    "cui-pagination": ".el-pagination",
    "cui-button--link": ".el-link"
  }
}
